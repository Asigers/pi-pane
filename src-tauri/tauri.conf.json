{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Pane",
  "version": "0.1.0",
  "identifier": "top.yoleo.pi-pane",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Pi Pane",
      "width": 1020,
      "height": 730,
      "minWidth": 620,
      "minHeight": 420,
      "backgroundColor": "#f6f5f1"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false }
    }
  }
}
